# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Payment mode
# dummy  = simulated payment (no real money charged — use this for testing)
# razorpay = real Razorpay checkout (requires keys below and PAYMENTS_ENABLED=true)
NEXT_PUBLIC_PAYMENTS_MODE=dummy

# Set to true only when PAYMENTS_MODE=razorpay and you are ready for live payments
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Razorpay (deferred — not used while PAYMENTS_MODE=dummy)
# Obtain from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email (Resend)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=onboarding@resend.dev

# App URL (used for absolute URL generation, OAuth callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key
